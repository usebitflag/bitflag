includes:
    - vendor/larastan/larastan/extension.neon

services:
    -
        class: Tools\PHPStan\Rules\NoModelWritesOutsideActionsRule
        tags:
            - phpstan.rules.rule

parameters:
    level: max
    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
    excludePaths:
        - bootstrap/cache
