includes:
    - vendor/larastan/larastan/extension.neon

services:
    -
        class: Tools\PHPStan\Rules\NoModelWritesOutsideActionsRule
        tags:
            - phpstan.rules.rule

parameters:
    level: max
    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
    excludePaths:
        - bootstrap/cache
    ignoreErrors:
        # No model uses the trait yet. This entry fails the analysis as soon as one does, which is the cue to remove it.
        -
            identifier: trait.unused
            path: app/Shared/Ids/HasPublicId.php
