APP_NAME=BitFlag
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Hosts. The portal is served on APP_HOST and the admin console on ADMIN_HOST; neither serves the other's routes.
APP_HOST=localhost
ADMIN_HOST=admin.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bitflag
DB_USERNAME=sail
DB_PASSWORD=password

# Host-only cookies: leave SESSION_DOMAIN unset so the portal and admin sessions never cross hosts.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure cookies default to on in production. Set false only for a deployment without HTTPS.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=bitflag

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@bitflag.test"
MAIL_FROM_NAME="${APP_NAME}"

# Test-only routes. They load only when this is true, the environment is local or testing,
# and the request carries the token. Never enable in production.
TESTING_E2E=false
TESTING_E2E_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Password for every demo user (local development and end-to-end tests only).
DEMO_PASSWORD=password

# Addresses of the load balancers in front of the application (comma separated), or * when the platform has none fixed.
TRUSTED_PROXIES=

# Days to keep delivered outbox messages before outbox:prune deletes them.
# OUTBOX_RETENTION_DAYS=14
