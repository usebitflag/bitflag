{
  "fonts": {
    "heading": "'Inter Variable', ui-sans-serif, system-ui, sans-serif",
    "body": "'Inter Variable', ui-sans-serif, system-ui, sans-serif",
    "mono": "'Azeret Mono Variable', ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "fontWeights": { "body": 400, "medium": 500, "heading": 600 },
  "fontSizes": {
    "2xs": "11px",
    "xs": "12px",
    "sm": "13px",
    "md": "13.5px",
    "base": "15px",
    "lg": "16px",
    "xl": "20px",
    "compact-title": "22px",
    "title": "24px"
  },
  "radius": { "sm": "6px", "md": "8px", "lg": "12px" },
  "layout": { "sidebar": "256px", "topbar": "56px" },
  "gradient": {
    "angle": "90deg",
    "stops": [
      { "color": "#735fe9", "at": "0%" },
      { "color": "#ce47eb", "at": "55%" },
      { "color": "#f47b74", "at": "100%" }
    ]
  },
  "themes": {
    "light": {
      "colorScheme": "light",
      "colors": {
        "bg": "#ffffff",
        "surface": "#ffffff",
        "sidebar": "#fafafa",
        "popover": "#ffffff",
        "text": "#0a0a0f",
        "muted": "#71717a",
        "divider": "#e7e7ea",
        "control-border": "#e7e7ea",
        "hover": "#f4f4f5",
        "primary": "#6d4fe0",
        "primary-foreground": "#ffffff",
        "primary-ink": "#5b3fd0",
        "backdrop": "#0a0a0f"
      },
      "mix": {
        "primary-soft": { "color": "primary", "into": "bg", "percent": 10 },
        "selection": { "color": "primary", "into": "bg", "percent": 25 }
      },
      "semantic": {
        "success": { "solid": "#059669", "text": "#047857", "subtle": 12, "border": 35 },
        "warning": { "solid": "#b45309", "text": "#92400e", "subtle": 12, "border": 35 },
        "danger": { "solid": "#dc2626", "text": "#b91c1c", "subtle": 12, "border": 35 }
      },
      "shadows": {
        "sm": "0 0 0 1px #e7e7ea",
        "md": "0 0 0 1px #e4e4e7, 0 8px 24px rgba(10, 10, 15, 0.08)",
        "lg": "0 0 0 1px #e4e4e7, 0 16px 40px rgba(10, 10, 15, 0.14)"
      }
    },
    "dark": {
      "colorScheme": "dark",
      "colors": {
        "bg": "#0b0b0f",
        "surface": "#111116",
        "sidebar": "#0e0e13",
        "popover": "#16161c",
        "text": "#f4f4f6",
        "muted": "#9a9aa6",
        "primary": "#8b6cf0",
        "primary-foreground": "#0b0b0f",
        "primary-ink": "#c7b8ff",
        "backdrop": "#000000"
      },
      "mix": {
        "divider": { "color": "#ffffff", "into": "bg", "percent": 9 },
        "control-border": { "color": "#ffffff", "into": "bg", "percent": 9 },
        "hover": { "color": "#ffffff", "into": "bg", "percent": 5 },
        "primary-soft": { "color": "primary", "into": "bg", "percent": 16 },
        "selection": { "color": "primary", "into": "bg", "percent": 35 }
      },
      "semantic": {
        "success": { "solid": "#34d399", "text": "#34d399", "subtle": 14, "border": 35 },
        "warning": { "solid": "#fbbf24", "text": "#fbbf24", "subtle": 14, "border": 35 },
        "danger": { "solid": "#f87171", "text": "#f87171", "subtle": 14, "border": 35 }
      },
      "shadows": {
        "sm": "0 0 0 1px #24242b",
        "md": "0 0 0 1px #2a2a32, 0 8px 24px rgba(0, 0, 0, 0.5)",
        "lg": "0 0 0 1px #2a2a32, 0 16px 40px rgba(0, 0, 0, 0.6)"
      }
    }
  },
  "contrast": [
    { "fg": "text", "bg": "bg", "min": 4.5 },
    { "fg": "text", "bg": "surface", "min": 4.5 },
    { "fg": "text", "bg": "sidebar", "min": 4.5 },
    { "fg": "text", "bg": "popover", "min": 4.5 },
    { "fg": "text", "bg": "hover", "min": 4.5 },
    { "fg": "muted", "bg": "bg", "min": 4.5 },
    { "fg": "muted", "bg": "surface", "min": 4.5 },
    { "fg": "muted", "bg": "sidebar", "min": 4.5 },
    { "fg": "muted", "bg": "popover", "min": 4.5 },
    { "fg": "primary-foreground", "bg": "primary", "min": 4.5 },
    { "fg": "primary-ink", "bg": "bg", "min": 4.5 },
    { "fg": "primary-ink", "bg": "primary-soft", "min": 4.5 },
    { "fg": "primary", "bg": "bg", "min": 3 },
    { "fg": "primary", "bg": "surface", "min": 3 },
    { "fg": "primary", "bg": "sidebar", "min": 3 },
    { "fg": "success-text", "bg": "bg", "min": 4.5 },
    { "fg": "success-text", "bg": "success-subtle", "min": 4.5 },
    { "fg": "success", "bg": "bg", "min": 3 },
    { "fg": "warning-text", "bg": "bg", "min": 4.5 },
    { "fg": "warning-text", "bg": "warning-subtle", "min": 4.5 },
    { "fg": "warning", "bg": "bg", "min": 3 },
    { "fg": "danger-text", "bg": "bg", "min": 4.5 },
    { "fg": "danger-text", "bg": "danger-subtle", "min": 4.5 },
    { "fg": "danger", "bg": "bg", "min": 3 }
  ]
}
