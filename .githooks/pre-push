#!/usr/bin/env bash
# Runs before every push.
#
# 1. Blocks direct pushes to main. Every change goes through a pull request.
# 2. Runs what CI and security run, on your machine, because Actions only runs after a merge to main:
#    scripts/check.sh, the production build checks, the isolated Cypress suite and a gitleaks scan. A push whose changes
#    are only documentation or GitHub settings skips the application checks.
#
# Enable once per clone:       git config core.hooksPath .githooks
# Skip the checks:             SKIP_CHECKS=1 git push
# Emergency push to main:      ALLOW_MAIN_PUSH=1 git push
set -euo pipefail

zero=0000000000000000000000000000000000000000
needs_checks=0
needs_full=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
    echo "Direct pushes to main are blocked. Push a branch and open a pull request." >&2
    exit 1
  fi

  # Deleting a branch has nothing to check.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  needs_checks=1
  base="$remote_sha"
  if [ "$base" = "$zero" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
  fi

  if [ -z "$base" ] || git diff --name-only "$base" "$local_sha" | grep -qvE '^(docs/|\.github/|.*\.md$)'; then
    needs_full=1
  fi
done

if [ "$needs_checks" = "0" ] || [ "${SKIP_CHECKS:-}" = "1" ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

if [ "$needs_full" = "1" ]; then
  if [ ! -x vendor/bin/sail ] || ! ./vendor/bin/sail ps --status running --quiet 2>/dev/null | grep -q .; then
    echo "The checks need Sail. Start it with ./vendor/bin/sail up -d, or push with SKIP_CHECKS=1." >&2
    exit 1
  fi

  echo "pre-push: running scripts/check.sh (SKIP_CHECKS=1 skips it)"
  ./vendor/bin/sail bash scripts/check.sh

  echo "pre-push: auditing production npm dependencies"
  ./vendor/bin/sail npm audit --omit=dev --audit-level=high

  echo "pre-push: checking the production build"
  ./vendor/bin/sail npm run build
  ./vendor/bin/sail node scripts/ci/scan-bundle-secrets.mjs
  bash scripts/ci/clean-tree.sh tracked-ignored
  bash scripts/ci/clean-tree.sh clean

  echo "pre-push: running Cypress end to end"
  scripts/dev/e2e-stack.sh up
  set +e
  CYPRESS_BASE_URL=http://localhost:8081 ./node_modules/.bin/cypress run \
    --browser "${CYPRESS_BROWSER:-chrome}" \
    --expose ADMIN_ORIGIN=http://admin.localhost:8081
  e2e_status=$?
  set -e
  scripts/dev/e2e-stack.sh down
  if [ "$e2e_status" -ne 0 ]; then
    exit "$e2e_status"
  fi
fi

if command -v docker >/dev/null 2>&1; then
  echo "pre-push: scanning for secrets"
  docker run --rm -v "$PWD:/repo" --entrypoint sh ghcr.io/gitleaks/gitleaks:v8.21.2 \
    -c "git config --global --add safe.directory /repo && gitleaks detect --source /repo --redact --no-banner"
else
  echo "pre-push: Docker is not available, so the secret scan was skipped." >&2
fi
