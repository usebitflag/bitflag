# Used by the end-to-end job: cp .env.e2e .env, then generate an application key.
APP_NAME=BitFlag
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Hosts. The portal is served on APP_HOST and the admin console on ADMIN_HOST; neither serves the other's routes.
APP_HOST=localhost
ADMIN_HOST=admin.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bitflag
DB_USERNAME=sail
DB_PASSWORD=password

# Host-only cookies: leave SESSION_DOMAIN unset so the portal and admin sessions never cross hosts.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure cookies default to on in production. Set false only for a deployment without HTTPS.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=bitflag

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@bitflag.test"
MAIL_FROM_NAME="${APP_NAME}"

# Test-only routes. They load only when this is true, the environment is local or testing,
# and the request carries the token. Never enable in production.
TESTING_E2E=true
TESTING_E2E_TOKEN=e2e-local-token

VITE_APP_NAME="${APP_NAME}"
# The end-to-end specs open the component gallery, which production builds leave out.
VITE_INCLUDE_DEV_PAGES=true
