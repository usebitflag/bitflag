{
  "name": "bitflag",
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"resources/**/*.css\"",
    "typecheck": "vue-tsc --noEmit && tsc -p cypress/tsconfig.json",
    "test": "vitest run",
    "e2e": "cypress run --browser chrome",
    "e2e:open": "cypress open",
    "test:coverage": "vitest run --coverage",
    "tokens": "node scripts/tokens/generate-theme.mjs",
    "tokens:check": "node scripts/tokens/generate-theme.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@laravel/vite-plugin-wayfinder": "^0.1.11",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.3",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@inertiajs/vue3": "^3.9.1",
    "@phosphor-icons/vue": "^2.2.1",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44"
  }
}
